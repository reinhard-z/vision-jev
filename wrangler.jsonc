{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-driver",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
